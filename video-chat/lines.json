  "text": "vậy mua hổ đi"
 },
 {
  "key": "goihoicham_5_9",
  "voice": "Ngọc Huyền",
  "text": "hổ cũng nhìn như đang đòi nợ"
 },
 {
  "key": "goihoicham_5_10",
  "voice": "Trúc Ly",
  "text": "thế mày muốn con nào"
 },
 {
  "key": "goihoicham_5_11",
  "voice": "Ngọc Huyền",
  "text": "con nào cũng được, miễn đừng nhìn tao"
 },
 {
  "key": "goihoicham_7_vo",
  "voice": "Ngọc Huyền",
  "text": "Gối tựa cổ hình dấu hỏi, có hổ, có cua, đủ màu để chọn. Còn hỏi mua ở đâu thì giỏ hàng ở góc trái video nha."
 }
]