[
 {
  "key": "botchuyentien_0_vo",
  "voice": "Ngọc Huyền",
  "text": "Bố chuyển tiền , cho con gái"
 },
 {
  "key": "botchuyentien_1_0",
  "voice": "Phạm Tuyên",
  "text": "con ơi bố chuyển thử một đồng rồi đó"
 },
 {
  "key": "botchuyentien_1_1",
  "voice": "Ngọc Huyền",
  "text": "dạ con nhận được rồi bố"
 },
 {
  "key": "botchuyentien_1_2",
  "voice": "Phạm Tuyên",
  "text": "nhận được thật không"
 },
 {
  "key": "botchuyentien_1_3",
  "voice": "Ngọc Huyền",
  "text": "thật ạ, có thông báo hẳn hoi"
 },
 {
  "key": "botchuyentien_1_4",
  "voice": "Phạm Tuyên",
  "text": "vậy bố chuyển thêm một đồng nữa cho chắc"
 },
 {
  "key": "botchuyentien_1_5",
  "voice": "Ngọc Huyền",
  "text": "bố chuyển tiền ăn luôn đi"
 },
 {
  "key": "botchuyentien_1_6",
  "voice": "Phạm Tuyên",
  "text": "đó là tiền ăn tuần này"
 },
 {
  "key": "botchuyentien_1_7",
  "voice": "Ngọc Huyền",
  "text": "hai đồng là tiền ăn cả tuần ạ"
 },
 {
  "key": "botchuyentien_1_8",
  "voice": "Phạm Tuyên",
  "text": "thì con ăn ít cho khỏe"
 },
 {
  "key": "botchuyentien_3_0",
  "voice": "Trúc Ly",
  "text": "bố ơi sao nội dung chuyển khoản dài vậy"
 },
 {
  "key": "botchuyentien_3_1",
  "voice": "Hải Đăng",
  "text": "bố viết để dặn con"
 },
 {
  "key": "botchuyentien_3_2",
  "voice": "Trúc Ly",
  "text": "con đọc nè, không mua trà sữa, không thức khuya, nhớ gọi cho mẹ"
 },
 {
  "key": "botchuyentien_3_3",
  "voice": "Hải Đăng",
  "text": "còn thiếu gì không"
 },
 {
  "key": "botchuyentien_3_4",
  "voice": "Trúc Ly",
  "text": "thiếu dấu chấm ạ"
 },
 {
  "key": "botchuyentien_3_5",
  "voice": "Hải Đăng",
  "text": "ngân hàng cho viết nhiều mà"
 },
 {
  "key": "botchuyentien_3_6",
  "voice": "Trúc Ly",
  "text": "bố dặn nhiều hơn số tiền luôn"
 },
 {
  "key": "botchuyentien_3_7",
  "voice": "Hải Đăng",
  "text": "tiền ít thì lời dặn phải nhiều"
 },
 {
  "key": "botchuyentien_5_0",
  "voice": "Hải Đăng",
  "text": "con nhớ học tốt nha, không thì bố thu hồi tiền"
 },
 {
  "key": "botchuyentien_5_1",
  "voice": "Ngọc Huyền",
  "text": "bố thu hồi tiền được á"
 },
 {
  "key": "botchuyentien_5_2",
  "voice": "Hải Đăng",
  "text": "bố đang tìm nút thu hồi"
 },
 {
  "key": "botchuyentien_5_3",
  "voice": "Ngọc Huyền",
  "text": "tiền chuyển thành công rồi bố"
 },
 {
  "key": "botchuyentien_5_4",
  "voice": "Hải Đăng",
  "text": "vậy bố tìm nút thu hồi lời dặn"
 },
 {
  "key": "botchuyentien_5_5",
  "voice": "Ngọc Huyền",
  "text": "không có nút đó đâu bố"
 },
 {
  "key": "botchuyentien_5_6",
  "voice": "Hải Đăng",
  "text": "thế con nhớ hết lời dặn nha"
 },
 {
  "key": "botchuyentien_7_0",
  "voice": "Phạm Tuyên",
  "text": "con ơi bố chuyển nhầm thêm một số không"
 },
 {
  "key": "botchuyentien_7_1",
  "voice": "Trúc Ly",
  "text": "dạ con thấy năm triệu thay vì năm trăm nghìn"
 },
 {
  "key": "botchuyentien_7_2",
  "voice": "Phạm Tuyên",
  "text": "con chuyển lại bốn triệu rưỡi cho bố nha"
 },
 {
  "key": "botchuyentien_7_3",
  "voice": "Trúc Ly",
  "text": "dạ để con chuyển thử một đồng trước đã"
 },
 {
  "key": "botchuyentien_7_4",
  "voice": "Phạm Tuyên",
  "text": "sao con giống bố vậy"
 },
 {
  "key": "botchuyentien_7_5",
  "voice": "Trúc Ly",
  "text": "con học bố mà"
 },
 {
  "key": "botchuyentien_7_6",
  "voice": "Phạm Tuyên",
  "text": "thôi con giữ luôn, từ giờ tự chuyển thử cho bố"
 },
 {
  "key": "botchuyentien_7_7",
  "voice": "Trúc Ly",
  "text": "con chuyển rồi, một đồng"
 },
 {
  "key": "botchuyentien_7_8",
  "voice": "Phạm Tuyên",
  "text": "ừ nhận rồi, đủ tiền ăn tuần này"
 }
]