[
 {
  "key": "goihoicham_0_vo",
  "voice": "Ngọc Huyền",
  "text": "Cái gối hình dấu hỏi , ai thấy cũng hỏi"
 },
 {
  "key": "goihoicham_1_0",
  "voice": "Ngọc Huyền",
  "text": "ê tao mới mua cái này"
 },
 {
  "key": "goihoicham_1_2",
  "voice": "Phạm Tuyên",
  "text": "tao nhìn ảnh mà thấy hoang mang"
 },
 {
  "key": "goihoicham_1_3",
  "voice": "Ngọc Huyền",
  "text": "hoang mang cái gì"
 },
 {
  "key": "goihoicham_1_4",
  "voice": "Phạm Tuyên",
  "text": "sáu cái dấu hỏi, tao chưa biết hỏi gì"
 },
 {
  "key": "goihoicham_1_5",
  "voice": "Ngọc Huyền",
  "text": "gối tựa cổ đó bà"
 },
 {
  "key": "goihoicham_1_6",
  "voice": "Phạm Tuyên",
