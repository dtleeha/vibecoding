  "text": "mày chọn con nào"
 },
 {
  "key": "goihoicham_5_2",
  "voice": "Ngọc Huyền",
  "text": "sao con hổ nhìn như đang tính tiền tao"
 },
 {
  "key": "goihoicham_5_3",
  "voice": "Trúc Ly",
  "text": "im đi, con này thì sao"
 },
 {
  "key": "goihoicham_5_5",
  "voice": "Ngọc Huyền",
  "text": "cua hai càng, quàng vô là kẹp cổ luôn hả"
 },
 {
  "key": "goihoicham_5_6",
  "voice": "Trúc Ly",
  "text": "không, càng để làm cảnh"
 },
 {
  "key": "goihoicham_5_7",
  "voice": "Ngọc Huyền",
  "text": "cảnh gì mà nhìn như bị bắt cóc"
 },
 {
  "key": "goihoicham_5_8",
