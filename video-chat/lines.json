 },
 {
  "key": "goihoicham_1_7",
  "voice": "Ngọc Huyền",
  "text": "thì hỏi mua ở đâu"
 },
 {
  "key": "goihoicham_1_8",
  "voice": "Phạm Tuyên",
  "text": "ừ, mua ở đâu"
 },
 {
  "key": "goihoicham_3_0",
  "voice": "Hải Đăng",
  "text": "em ơi tối nay họp nhanh thôi"
 },
 {
  "key": "goihoicham_3_1",
  "voice": "Trúc Ly",
  "text": "dạ bao nhiêu phút ạ"
 },
 {
  "key": "goihoicham_3_2",
  "voice": "Hải Đăng",
  "text": "ba mươi phút"
 },
 {
  "key": "goihoicham_3_3",
  "voice": "Trúc Ly",
  "text": "sếp nói nhanh thôi mà"
 },
 {
  "key": "goihoicham_3_4",
  "voice": "Hải Đăng",
  "text": "thì ba mươi phút thôi"
 },
 {
  "key": "goihoicham_3_5",
  "voice": "Trúc Ly",
  "text": "lần trước cũng nhanh thôi, hai tiếng"
 },
 {
  "key": "goihoicham_5_0",
